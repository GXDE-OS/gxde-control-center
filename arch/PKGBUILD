# Maintainer: CharOfString <root@charofstring.cc>
pkgname=gxde-control-center-git
pkgver=6.1.1
pkgrel=1
pkgdesc='Control center for GXDE'
arch=('x86_64' 'aarch64')
url="https://github.com/GXDE-OS/gxde-control-center"
license=('GPL-3.0-or-later')
# 依赖取自 debian/control（xkb-data→xkeyboard-config、passwd→shadow、systemd-timesyncd→systemd、
# libspa-0.2-bluetooth→pipewire-audio）
# Depends from debian/control (xkb-data→xkeyboard-config, passwd→shadow,
# systemd-timesyncd→systemd, libspa-0.2-bluetooth→pipewire-audio).
depends=('gxde-account-faces-git' 'deepin-daemon-git' 'gxde-api-git' 'xkeyboard-config'
         'gxde-installer-timezones-git' 'shadow' 'gxde-top-panel-git' 'systemd' 'networkmanager-qt'
         'dframework-dbus-qt6-git' 'gxde-network-utils-qt6-git' 'garma-git' 'gxde-app-installer-git'
         'gxde-app-upgrader-git' 'gxde-app-uninstaller-git' 'gxde-shell-tools-git' 'transhell-git'
         'wireplumber' 'pipewire-audio'
         'dtk2widget-qt6-git' 'dtk6core-git' 'dtk6log-git' 'gsettings-qt6' 'layer-shell-qt' 'libnm' 'glib2'
         'gxde-bernese-git' 'qt6-base' 'qt6-svg' 'qt6-multimedia' 'packagekit-qt6' 'wayland' 'libx11' 'libxext' 'libxcb' 'xcb-util-wm'
         'libgcc' 'libstdc++' 'glibc')
optdepends=('x11vnc: remote desktop over VNC'
            'redshift: night light')
makedepends=('git' 'cmake' 'ninja' 'qt6-tools')
provides=('gxde-control-center' 'deepin-control-center')
conflicts=('gxde-control-center' 'deepin-control-center')
source=()
sha512sums=()

# 直接使用 PKGBUILD 所在的 git 仓库作为源码 ・ Build from the git checkout this PKGBUILD lives in.
_srcroot() {
  git -C "$startdir" rev-parse --show-toplevel
}

build() {
  local _opts=(-DDCC_UPDATE_USE_PACKAGEKIT=YES -DDCC_DISABLE_TESTING_GROUP=YES)
  # 与 debian/rules 中 arm64 的选项相同 ・ Same options as arm64 in debian/rules.
  [[ $CARCH == aarch64 ]] && _opts+=(-DDISABLE_SYS_UPDATE_SOURCE_CHECK=YES -DDISABLE_SYS_UPDATE_MIRRORS=YES)
  cmake -B build -S "$(_srcroot)" -GNinja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    "${_opts[@]}"
  ninja -C build
}

package() {
  DESTDIR="$pkgdir" ninja -C build install
}
