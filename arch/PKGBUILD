# Maintainer: CharOfString <root@charofstring.cc>
pkgname=gxde-control-center
pkgver=6.1.12
pkgrel=1
pkgdesc='Control center for GXDE'
arch=('x86_64' 'aarch64')
url="https://github.com/GXDE-OS/gxde-control-center"
license=('GPL-3.0-or-later')

depends=('gxde-account-faces' 'gxde-deepin-daemon' 'gxde-api' 'xkeyboard-config'
         'gxde-installer-timezones' 'shadow' 'gxde-top-panel' 'systemd' 'networkmanager-qt'
         'dframework-dbus-qt6' 'gxde-network-utils-qt6' 'garma' 'gxde-app-installer'
         'gxde-app-upgrader' 'gxde-app-uninstaller' 'gxde-shell-tools' 'transhell'
         'wireplumber' 'pipewire-audio'
         'dtk2widget-qt6' 'gxde-dtk6core' 'gxde-dtk6log' 'gsettings-qt6' 'layer-shell-qt' 'libnm' 'glib2'
         'gxde-bernese' 'qt6-base' 'qt6-svg' 'qt6-multimedia' 'packagekit-qt6' 'wayland' 'libx11' 'libxext' 'libxcb' 'xcb-util-wm'
         'libgcc' 'libstdc++' 'glibc')
optdepends=('x11vnc: remote desktop over VNC'
            'redshift: night light')
makedepends=('git' 'cmake' 'ninja' 'qt6-tools')
provides=('deepin-control-center' "gxde-control-center-git=$pkgver")
conflicts=('deepin-control-center' 'gxde-control-center-git')
replaces=('gxde-control-center-git')
source=()
sha512sums=()

_srcroot() {
  git -C "$startdir" rev-parse --show-toplevel
}

build() {
  local _opts=(-DDCC_UPDATE_USE_PACKAGEKIT=YES -DDCC_DISABLE_TESTING_GROUP=YES)
  [[ $CARCH == aarch64 ]] && _opts+=(-DDISABLE_SYS_UPDATE_SOURCE_CHECK=YES -DDISABLE_SYS_UPDATE_MIRRORS=YES)
  cmake -B build -S "$(_srcroot)" -GNinja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    "${_opts[@]}"
  ninja -C build
}

package() {
  DESTDIR="$pkgdir" ninja -C build install
}
