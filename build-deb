# 此脚本用于在调试时生成安装包，便于在调试机器上轻松部署与卸载。
#
# 与旧模板不同，本脚本「化简」了构建流程，所有项目相关信息都从 debian/ 自动推导，
# 通常无需逐项目改脚本：
#   - 构建依赖：从 debian/control 的 Build-Depends 自动安装（apt build-dep），不再手写包名；
#   - 包名/产物名：从 debian/changelog 自动取得，清理时据此删除上级目录的产物；
#   - 构建系统（cmake/meson/…）：由 debian/rules 决定，脚本不关心。
#
# 用法: ./build-deb <选项>
#
# 选项:
#    -b, --binary          仅构建二进制包（默认行为）
#    -d, --install-deps    先安装构建依赖(读 debian/control)，再构建
#    -c, --clean           仅清理构建产物后退出
#    -h, --help            打印帮助信息

set -o pipefail

# 路径配置：本脚本位于项目根目录(与 debian/ 同级)，故项目根 = 脚本所在目录。
CUR_SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJ_ROOT="$CUR_SCRIPT_DIR"

# 参数
BUILD_BIN=true
INSTALL_DEPS=false
ACT_CLEANUPS=false

# 包名(从 debian/changelog 推导，用于清理上级目录的产物)
PKG_NAME=""

# 打印帮助
print_help() {
    echo "使用方法: $0 <选项>"
    echo ""
    echo "可用选项:"
    echo "  -b, --binary          仅构建二进制包(默认行为)"
    echo "  -d, --install-deps    先按 debian/control 安装构建依赖，再构建二进制包"
    echo "  -c, --clean           清理构建产物后退出"
    echo "  -h, --help            打印此信息"
    echo ""
    echo "用法示例:"
    echo "  $0 -d                # 装齐构建依赖并构建"
    echo "  $0                   # 直接构建(依赖已就绪)"
    echo "  $0 -c                # 清理构建产物"
    exit 0
}

# 解析参数
parse_args() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            -b|--binary)
                BUILD_BIN=true
                shift
                ;;
            -c|--clean)
                ACT_CLEANUPS=true
                shift
                ;;
            -d|--install-deps)
                INSTALL_DEPS=true
                BUILD_BIN=true
                shift
                ;;
            -h|--help)
                print_help
                ;;
            *)
                echo "未知选项: $1"
                echo "以下文档可能有帮助: "
                print_help
                ;;
        esac
    done
}

# Util: 检查命令是否存在
is_cmd_exists() {
    command -v "$1" &> /dev/null
}

# 校验项目结构 + 取包名
detect_project() {
    if [[ ! -f "$PROJ_ROOT/debian/control" || ! -f "$PROJ_ROOT/debian/changelog" ]]; then
        echo "错误: 在 $PROJ_ROOT 下未找到 debian/control 或 debian/changelog。"
        echo "本脚本需与 debian/ 同级放在项目根目录。"
        exit 1
    fi
    PKG_NAME="$(cd "$PROJ_ROOT" && dpkg-parsechangelog -S Source 2>/dev/null)"
    if [[ -z "$PKG_NAME" ]]; then
        echo "错误: 无法从 debian/changelog 解析源码包名。"
        exit 1
    fi
    echo "项目根目录: $PROJ_ROOT"
    echo "源码包名:   $PKG_NAME"
}

# 检查最基本的工具链(其余构建工具由 debian/control 的 Build-Depends 提供)
check_toolchains() {
    echo "正在检查基础工具链，请稍候..."
    local missing_tools=()

    # dpkg-buildpackage / dpkg-parsechangelog 均来自 dpkg-dev
    if ! is_cmd_exists "dpkg-buildpackage"; then
        missing_tools+=("dpkg-dev")
    fi
    # apt-get build-dep 用于自动装构建依赖
    if ! is_cmd_exists "apt-get"; then
        missing_tools+=("apt")
    fi

    if [[ ${#missing_tools[@]} -gt 0 ]]; then
        echo "缺少以下基础工具: ${missing_tools[*]}"
        echo "可以尝试运行 sudo apt install ${missing_tools[*]}"
        exit 1
    fi
    echo "基础工具链检查通过！"
}

# 安装构建依赖：直接读 debian/control 的 Build-Depends，不再手写包名。
auto_install_deps() {
    if [[ "$INSTALL_DEPS" != true ]]; then
        return
    fi
    echo "准备按 debian/control 安装构建依赖，请稍候..."
    sudo apt-get update

    echo ""
    echo ">>> 注意：以下 apt 操作未加 -y，请仔细核对「将要安装 / 将要卸载」，"
    echo ">>>       确认不会有任何 GXDE 系统包被冲突卸载！！"
    echo ""
    # apt-get build-dep 直接解析本目录 debian/control 的 Build-Depends
    sudo apt-get build-dep "$PROJ_ROOT"
    echo "构建依赖安装完成。"
}

# 预取 meson 子项目
# deb 构建时 dh 的 meson 后端会加 --wrap-mode=nodownload(Debian 策略:构建过程不联网),
# 此时 meson 无法再去拉 wrap 子项目。故在调用 dpkg-buildpackage 之前(此阶段允许联网)
# 先把 subprojects/*.wrap 拉成本地目录;已存在的子项目会被 meson 跳过。
prefetch_subprojects() {
    [[ -d subprojects ]] || return 0
    shopt -s nullglob
    local wraps=(subprojects/*.wrap)
    shopt -u nullglob
    [[ ${#wraps[@]} -eq 0 ]] && return 0

    if ! is_cmd_exists meson; then
        echo "警告: 未找到 meson，跳过子项目预取(若子项目已 vendored 则可忽略)。"
        return 0
    fi
    echo "预取 meson 子项目(wrap → subprojects/，已存在的会跳过)..."
    if ! meson subprojects download; then
        echo "错误: meson subprojects download 失败(检查网络 / git / wrap 配置)。"
        exit 1
    fi
}

# 清理构建产物
exec_clean() {
    echo "执行清理..."
    cd "$PROJ_ROOT" || exit 1

    local host_gnu_type=""
    local package=""
    local -a binary_packages=()
    local -a generated_paths=()
    local -a parent_artifacts=()

    if [[ ! "$PKG_NAME" =~ ^[a-z0-9][a-z0-9+.-]*$ ]]; then
        echo "错误: 源码包名不合法，拒绝执行清理: $PKG_NAME"
        return 1
    fi

    # 读取本源码包实际生成的全部二进制包名，避免写死项目名称。
    while IFS= read -r package; do
        if [[ "$package" =~ ^[a-z0-9][a-z0-9+.-]*$ ]]; then
            binary_packages+=("$package")
        fi
    done < <(awk '$1 == "Package:" { print $2 }' debian/control)

    if [[ ${#binary_packages[@]} -eq 0 ]]; then
        echo "错误: 无法从 debian/control 解析二进制包名，拒绝执行清理。"
        return 1
    fi

    # 先交给项目自己的 clean 规则处理构建系统产物。
    if ! debian/rules clean; then
        echo "警告: debian/rules clean 执行失败，将继续清理已知的打包产物。"
    fi

    # 仅兜底删除 Debhelper 的确定路径和当前架构的构建目录，不使用 obj-*/。
    generated_paths=(
        "$PROJ_ROOT/debian/.debhelper"
        "$PROJ_ROOT/debian/tmp"
        "$PROJ_ROOT/debian/files"
        "$PROJ_ROOT/debian/debhelper-build-stamp"
    )

    host_gnu_type="$(dpkg-architecture -qDEB_HOST_GNU_TYPE 2>/dev/null)"
    if [[ -n "$host_gnu_type" ]]; then
        generated_paths+=("$PROJ_ROOT/obj-$host_gnu_type")
    fi

    for package in "${binary_packages[@]}"; do
        generated_paths+=(
            "$PROJ_ROOT/debian/$package"
            "$PROJ_ROOT/debian/$package.debhelper.log"
            "$PROJ_ROOT/debian/$package.substvars"
        )
    done

    if ! rm -rf -- "${generated_paths[@]}"; then
        echo "错误: 清理项目内构建产物失败。"
        return 1
    fi

    # 展开当前源码包和二进制包的已知产物；nullglob 防止把未匹配模式传给 rm。
    shopt -s nullglob
    parent_artifacts=(
        "$PROJ_ROOT/../${PKG_NAME}"_*.build
        "$PROJ_ROOT/../${PKG_NAME}"_*.buildinfo
        "$PROJ_ROOT/../${PKG_NAME}"_*.changes
        "$PROJ_ROOT/../${PKG_NAME}"_*.diff.*
        "$PROJ_ROOT/../${PKG_NAME}"_*.dsc
        "$PROJ_ROOT/../${PKG_NAME}"_*.tar.*
    )
    for package in "${binary_packages[@]}"; do
        parent_artifacts+=(
            "$PROJ_ROOT/../${package}"_*.deb
            "$PROJ_ROOT/../${package}"_*.ddeb
            "$PROJ_ROOT/../${package}"_*.udeb
            "$PROJ_ROOT/../${package}"-dbgsym_*.deb
        )
    done
    shopt -u nullglob

    if [[ ${#parent_artifacts[@]} -gt 0 ]] \
        && ! rm -f -- "${parent_artifacts[@]}"; then
        echo "错误: 清理上级目录中的打包产物失败。"
        return 1
    fi

    echo "清理完成！"
}

# 构建
exec_build() {
    local dpkg_args=("-us" "-uc")
    [[ "$BUILD_BIN" == true ]] && dpkg_args+=("-b")

    cd "$PROJ_ROOT" || exit 1
    # prefetch_subprojects
    echo "开始使用 dpkg-buildpackage 构建&打包(参数: ${dpkg_args[*]})..."
    dpkg-buildpackage "${dpkg_args[@]}"

    echo "构建完成。Deb 包应位于上级目录:"
    ls -1 ../"${PKG_NAME}"*_*.deb 2>/dev/null || echo "  (未找到 .deb，请检查上面的构建输出)"
}

# 主脚本
echo "========================================="
echo "      GXDE DEB 构建脚本 REL 1.0.0"
echo "========================================="
echo ""

parse_args "$@"
detect_project

if [[ "$ACT_CLEANUPS" == true ]]; then
    exec_clean
    exit 0
fi

check_toolchains
auto_install_deps
exec_build
